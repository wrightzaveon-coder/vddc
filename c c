                end
            else
                Notifier.new({Title="Vehicle",Content="No owned car was found.",Duration=3})
            end
        end
    })
    CarTools:AddButton({
        Name = "Sit In Owned Car",
        Callback = function()
            local character = game:GetService("Players").LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local seat = ownedVehicle()
            if seat and root and humanoid then
                seatInVehicle(seat)
            else
                Notifier.new({Title="Vehicle",Content="No owned car was found.",Duration=3})
            end
        end
    })
    CarTools:AddButton({
        Name = "Freeze / Unfreeze Vehicle",
        Callback = function()
            local seat = activeSeat()
            if not seat then seat = ownedVehicle() end
            local model = seat and seat:FindFirstAncestorOfClass("Model")
            if not model then return end
            getgenv().ScorpioHubCarFrozen = not getgenv().ScorpioHubCarFrozen
            for _, part in ipairs(model:GetDescendants()) do
                if part:IsA("BasePart") then part.Anchored = getgenv().ScorpioHubCarFrozen end
            end
        end
    })
    CarTools:AddButton({
        Name = "Unlock All Cars",
        Callback = function()
            for _, seat in ipairs(workspace:GetDescendants()) do
                if seat:IsA("VehicleSeat") then seat.Disabled = false end
            end
        end
    })
end

