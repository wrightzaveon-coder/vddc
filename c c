local function SizeProPADTablet()
	local camera = workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local aspectRatio = TabletConfiguration.SourceWidth / TabletConfiguration.SourceHeight
	local widthScale = UserInputService.TouchEnabled and TabletConfiguration.MobileWidthScale or TabletConfiguration.DesktopWidthScale
	local maxW = viewport.X * widthScale
	local maxH = viewport.Y * TabletConfiguration.MaximumHeightScale
	local finalW = math.min(maxW, maxH * aspectRatio)
	local finalH = finalW / aspectRatio
	ProPADTabletRoot.Size = UDim2.fromOffset(finalW, finalH)
	local host = AutoProScreenHost.AbsoluteSize
	if host.X > 0 and host.Y > 0 then
		CanvasScale.Scale = math.min(
			host.X / TabletConfiguration.DesignWidth,
			host.Y / TabletConfiguration.DesignHeight
		)
	end
end
_G._SCORPIOHUB_SizeTablet = SizeProPADTablet
trackConn(AutoProScreenHost:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	local host = AutoProScreenHost.AbsoluteSize
	if host.X > 0 and host.Y > 0 then
		CanvasScale.Scale = math.min(host.X / TabletConfiguration.DesignWidth, host.Y / TabletConfiguration.DesignHeight)
	end
	if _G.__SCORPIO_RefreshLayouts then _G.__SCORPIO_RefreshLayouts() end
end))
SizeProPADTablet()
