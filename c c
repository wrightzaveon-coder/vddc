getgenv()._ScorpioHubCarFlyHeartbeat = trackConn(RunService.Heartbeat:Connect(function()
	if not ScorpioHubAlive() then return end
	if not getgenv().CarFlyEnabled then
		if carFlyBV or carFlyBG then stopCarFly() end
		return
	end
	local char = LP.Character
	local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
	if not humanoid or not humanoid.SeatPart then
		if carFlyBV or carFlyBG then stopCarFly() end
		return
	end
	if not carFlyBV or not carFlyBG or carFlySeat ~= humanoid.SeatPart then
		if not startCarFly() then return end
	end
	local cam = workspace.CurrentCamera
	if not cam or not carFlyPart or not carFlyPart.Parent then return end
	local direction = Vector3.zero
	local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
	local right = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
	if look.Magnitude > 0 then look = look.Unit end
	if right.Magnitude > 0 then right = right.Unit end
	if UIS.TouchEnabled then
		local moveDirection = humanoid.MoveDirection
		if moveDirection.Magnitude > 0.1 then
			direction += Vector3.new(moveDirection.X, 0, moveDirection.Z)
		end
		local pad = getgenv().ScorpioHubCarFlyInput
		direction += look * (pad.Forward or 0)
		direction += right * (pad.Right or 0)
		direction += Vector3.new(0, pad.Up or 0, 0)
	end
	if UIS:IsKeyDown(Enum.KeyCode.W) then direction += look end
	if UIS:IsKeyDown(Enum.KeyCode.S) then direction -= look end
	if UIS:IsKeyDown(Enum.KeyCode.A) then direction -= right end
	if UIS:IsKeyDown(Enum.KeyCode.D) then direction += right end
	if UIS:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.new(0, 1, 0) end
	if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
		direction -= Vector3.new(0, 1, 0)
	end
	local velocity = direction.Magnitude > 0
		and direction.Unit * (getgenv()._ccCarFlySpeed or 55)
		or Vector3.zero
	carFlyBV.Velocity = velocity
	carFlyPart.AssemblyLinearVelocity = velocity
	carFlyPart.AssemblyAngularVelocity = Vector3.zero
	carFlyBG.CFrame = cam.CFrame
end))

