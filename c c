	if not dragging then return end
	if io.UserInputType ~= Enum.UserInputType.MouseMovement and io.UserInputType ~= Enum.UserInputType.Touch then return end
	local delta = io.Position - dragStart
	local newScaleX, newScaleY = startPos.X.Scale, startPos.Y.Scale
	local newOffsetX = startPos.X.Offset + delta.X
	local newOffsetY = startPos.Y.Offset + delta.Y
	local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	local halfW = ProPADTabletRoot.AbsoluteSize.X * 0.5
	local halfH = ProPADTabletRoot.AbsoluteSize.Y * 0.5
	local centerX = newScaleX * vp.X + newOffsetX
	local centerY = newScaleY * vp.Y + newOffsetY
	centerX = math.clamp(centerX, -halfW + 80, vp.X + halfW - 80)
	centerY = math.clamp(centerY, -halfH + 40, vp.Y + halfH - 40)
	newOffsetX = centerX - newScaleX * vp.X
	newOffsetY = centerY - newScaleY * vp.Y
	ProPADTabletRoot.Position = UDim2.new(newScaleX, newOffsetX, newScaleY, newOffsetY)
end))

