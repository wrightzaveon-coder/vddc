_G.HeadSize  = 15
_G.HeadColor = Color3.fromRGB(255, 0, 0)
local hitboxSettings = { Enabled = false, Transparency = 0.4 }
local originalProperties = {}

local function findHead(char)
    for _, v in ipairs(char:GetChildren()) do
        if (v:IsA("Part") or v:IsA("MeshPart")) and v.Name == "Head" then return v end
    end
end

local function saveOrigProps(player, head)
    if not originalProperties[player.UserId] then
        originalProperties[player.UserId] = {
            Size         = head.Size,
            Color        = head.Color,
            Material     = head.Material,
            Transparency = head.Transparency,
            CanCollide   = head.CanCollide,
            Massless     = head.Massless,
        }
    end
end

local function restoreOrigProps(player, head)
    local o = originalProperties[player.UserId]
    if o then
        head.Size         = o.Size
        head.Color        = o.Color
        head.Material     = o.Material
        head.Transparency = o.Transparency
        head.CanCollide   = o.CanCollide
        head.Massless     = o.Massless
        originalProperties[player.UserId] = nil
    end
end

function applyHitbox(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    local head = findHead(char)
    if not head then return end

    if hitboxSettings.Enabled then
        saveOrigProps(player, head)
        head.Size         = Vector3.new(_G.HeadSize, _G.HeadSize, _G.HeadSize)
        head.Color        = _G.HeadColor
        head.Material     = Enum.Material.Neon
        head.Transparency = hitboxSettings.Transparency
        head.CanCollide   = false
        head.Massless     = true
    else
        restoreOrigProps(player, head)
    end
end

local function setupHitboxPlayer(player)
    player.CharacterAdded:Connect(function(char)
        local head
        for i = 1, 100 do
            head = findHead(char)
            if head then break end
            task.wait(0.1)
        end
        if head then applyHitbox(player) end
    end)
    if player.Character then applyHitbox(player) end
end

for _, p in pairs(Players:GetPlayers()) do setupHitboxPlayer(p) end
Players.PlayerAdded:Connect(setupHitboxPlayer)

trackConn(RunService.Heartbeat:Connect(function()
    if not hitboxSettings.Enabled then return end
    for _, p in pairs(Players:GetPlayers()) do
        pcall(function() applyHitbox(p) end)
    end
end))

