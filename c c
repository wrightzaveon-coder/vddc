local function makeFragment(parent, order, pattern)
	local f = Create("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(12, 0, 0),
		BorderSizePixel = 0,
		Text = "",
		Size = UDim2.new(0.5, -4, 0.25, -4),
		LayoutOrder = order,
		ZIndex = 13,
		Parent = parent,
	})
	AddCorner(f, 2)
	local stroke = AddStroke(f, Theme.Cyan, 1, 0.3)
	AddCornerBrackets(f, Theme.Cyan, 6, 1)
	local overlay = Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -12, 1, -12),
		Position = UDim2.new(0, 6, 0, 6),
		ClipsDescendants = true,
		ZIndex = 14,
		Parent = f,
	})
	for _, seg in ipairs(pattern) do
		Create("Frame", {
			BackgroundColor3 = Theme.NeonGreen,
			BackgroundTransparency = 0.15,
			BorderSizePixel = 0,
			Position = UDim2.new(seg[1], 0, seg[2], 0),
			Size = UDim2.new(seg[3], 0, seg[4], 0),
			Rotation = seg[5] or 0,
			ZIndex = 14,
			Parent = overlay,
		})
	end
	return f, stroke
end

local function randomPattern(seed)
	math.randomseed(seed)
	local segs = {}
	for _ = 1, 6 + math.random(0, 4) do
		local x = math.random() * 0.8
		local y = math.random() * 0.8
		local w = 0.1 + math.random() * 0.6
		local h = math.random() > 0.5 and 0.02 or 0.15
		local rot = math.random() > 0.5 and (math.random(-45, 45)) or 0
		table.insert(segs, { x, y, w, h, rot })
	end
	math.randomseed(os.clock() * 1000)
	return segs
end

