local allowedTools = {
    Cleaver = true,
    Axe = true,
    Blade = true,
    Machete = true
}

getgenv().SwimMethod = false

local function enableSwimMethod()
    getgenv().SwimMethod = true
end

local function disableSwimMethod()
    getgenv().SwimMethod = false
end

local function GetAttackEvent(tool)
    if tool then
        local meleeSystem = tool:FindFirstChild("MeleeSystem")
        if meleeSystem and meleeSystem:FindFirstChild("AttackEvent") then
            return meleeSystem.AttackEvent
        end
    end
    return nil
end

local function GetKnifeTool(player)
    local character = player.Character
    local backpack = player:FindFirstChild("Backpack")

    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and allowedTools[tool.Name] then
                return tool
            end
        end
    end

    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and allowedTools[tool.Name] then
                return tool
            end
        end
    end

    return nil
end

local function EquipKnife(player)
    local knife = GetKnifeTool(player)
    if not knife then return nil end

    if knife.Parent ~= player.Character then
        knife.Parent = player.Character
        task.wait(0.15)
    end

    return knife
end

local function CrazyKnifeSequence()
    local player = LocalPlayer
    local character = player.Character
    if not character then return end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local target = State.SelectedPlayer
    if not target or not target.Character then
        Notifier.new({
            Title = "Knife",
            Content = "No valid target selected",
            Duration = 3
        })
        return
    end

    local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
    local humanoid = target.Character:FindFirstChild("Humanoid")
    if not targetHRP or not humanoid or humanoid.Health <= 0 then
        Notifier.new({
            Title = "Knife",
            Content = "Target invalid or already dead",
            Duration = 3
        })
        return
    end

    local knife = EquipKnife(player)
    if not knife then
        Notifier.new({
            Title = "Knife",
            Content = "Must have a knife (Cleaver/Axe/Blade/Machete)",
            Duration = 4
        })
        return
    end

    local attackEvent = GetAttackEvent(knife)
    if not attackEvent then
        Notifier.new({
            Title = "Knife",
            Content = "Knife has no AttackEvent",
            Duration = 3
        })
        return
    end

    local originalCFrame = hrp.CFrame
    enableSwimMethod()

    while ScorpioHubAlive() and humanoid.Health > 0 do
        if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
            break
        end

        targetHRP = target.Character.HumanoidRootPart
        hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 1.2)
        attackEvent:FireServer()
        task.wait(0.05)
    end

    hrp.CFrame = originalCFrame
    disableSwimMethod()

    Notifier.new({
        Title = "Knife",
        Content = target.Name .. " is dead.",
        Duration = 5
    })
end

