local gunsFolder = workspace:FindFirstChild("GUNS")
if not gunsFolder then
	warn("GUNS folder not found in workspace!")
	return
end

local validGunNames = {}
for _, gun in ipairs(gunsFolder:GetChildren()) do
	validGunNames[gun.Name] = true
end

local enabled = false
local activeRainbowThreads = {}
local connections = {}
local originalStates = {}

local function storeOriginalState(part)
	if not originalStates[part] then
		originalStates[part] = {
			Color = part.Color,
			Material = part.Material,
			Transparency = part.Transparency,
			Reflectance = part.Reflectance
		}
	end
end

local function startRainbow(tool)
	if not enabled or activeRainbowThreads[tool] then return end

	local parts = {}
	for _, part in ipairs(tool:GetDescendants()) do
		if part:IsA("BasePart") then
			storeOriginalState(part)
			table.insert(parts, part)
		end
	end
	if #parts == 0 then return end

	local stopped = false
	activeRainbowThreads[tool] = function()
		stopped = true
	end

	task.spawn(function()
		for _, part in ipairs(parts) do
			part.Material = Enum.Material.Neon
			part.Transparency = 0.05
			part.Reflectance = 0.15
		end

		while ScorpioHubAlive() and not stopped and enabled do
			local hue = (tick() * 0.35) % 1
			local color = Color3.fromHSV(hue, 1, 1)

			for _, part in ipairs(parts) do
				part.Color = color
			end

			task.wait(0.02)
		end
	end)
end

local function restoreTool(tool)
	for _, part in ipairs(tool:GetDescendants()) do
		local state = originalStates[part]
		if part:IsA("BasePart") and state then
			part.Color = state.Color
			part.Material = state.Material
			part.Transparency = state.Transparency
			part.Reflectance = state.Reflectance or 0
			originalStates[part] = nil
		end
	end
end

local function stopAll()
	for tool, stopper in pairs(activeRainbowThreads) do
		stopper()
		restoreTool(tool)
	end
	activeRainbowThreads = {}
	originalStates = {}
end

local function onToolAdded(tool)
	if enabled and tool:IsA("Tool") and validGunNames[tool.Name] then
		startRainbow(tool)
	end
end

local function enable()
	if enabled then return end
	enabled = true

	for _, tool in ipairs(player.Backpack:GetChildren()) do
		onToolAdded(tool)
	end
	if player.Character then
		for _, tool in ipairs(player.Character:GetChildren()) do
			onToolAdded(tool)
		end
	end

	table.insert(connections, player.Backpack.ChildAdded:Connect(onToolAdded))
	table.insert(connections, player.CharacterAdded:Connect(function(char)
		table.insert(connections, char.ChildAdded:Connect(onToolAdded))
	end))
end

local function disable()
	if not enabled then return end
	enabled = false

	stopAll()

	for _, conn in ipairs(connections) do
		conn:Disconnect()
	end
	connections = {}
end

