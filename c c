local skyLighting = game:GetService("Lighting")
local skyOriginal = getgenv().ScorpioHubOriginalSky
local skyboxTextures = {
    ["Songbob"] = "rbxassetid://15912530252",
    ["Hacker"] = "rbxassetid://83026768226546",
    ["Galaxy"] = "rbxassetid://13581437029",
    ["Pink"] = "rbxassetid://12635309703",
    ["Project TX"] = "rbxassetid://76119642997686"
}

local function rememberSky(sky)
    if skyOriginal then return end
    if not sky then
        skyOriginal = {existed = false}
        getgenv().ScorpioHubOriginalSky = skyOriginal
        return
    end
    skyOriginal = {
        existed = true,
        Bk = sky.SkyboxBk,
        Dn = sky.SkyboxDn,
        Ft = sky.SkyboxFt,
        Lf = sky.SkyboxLf,
        Rt = sky.SkyboxRt,
        Up = sky.SkyboxUp,
        Stars = sky.StarCount,
        SunSize = sky.SunAngularSize,
        MoonSize = sky.MoonAngularSize
    }
    getgenv().ScorpioHubOriginalSky = skyOriginal
end

local function applySkybox(name)
    local texture = skyboxTextures[name]
    if not texture then return end
    local sky = skyLighting:FindFirstChildOfClass("Sky")
    rememberSky(sky)
    if not sky then
        sky = Instance.new("Sky")
        sky.Parent = skyLighting
    end
    sky.SkyboxBk = texture
    sky.SkyboxDn = texture
    sky.SkyboxFt = texture
    sky.SkyboxLf = texture
    sky.SkyboxRt = texture
    sky.SkyboxUp = texture
    sky.StarCount = 0
    sky.SunAngularSize = 0
    sky.MoonAngularSize = 0
    Notifier.new({
        Title = "Skybox",
        Content = name .. " applied",
        Duration = 2,
        Icon = "rbxassetid://106158051045949"
    })
end

local function resetSkybox()
    if not skyOriginal then return end
    local sky = skyLighting:FindFirstChildOfClass("Sky")
    if skyOriginal.existed then
        if not sky then
            sky = Instance.new("Sky")
            sky.Parent = skyLighting
        end
        sky.SkyboxBk = skyOriginal.Bk
        sky.SkyboxDn = skyOriginal.Dn
        sky.SkyboxFt = skyOriginal.Ft
        sky.SkyboxLf = skyOriginal.Lf
        sky.SkyboxRt = skyOriginal.Rt
        sky.SkyboxUp = skyOriginal.Up
        sky.StarCount = skyOriginal.Stars
        sky.SunAngularSize = skyOriginal.SunSize
        sky.MoonAngularSize = skyOriginal.MoonSize
    elseif sky then
        sky:Destroy()
    end
    skyOriginal = nil
    getgenv().ScorpioHubOriginalSky = nil
    Notifier.new({
        Title = "Skybox",
        Content = "Reset to original",
        Duration = 2,
        Icon = "rbxassetid://106158051045949"
    })
end

