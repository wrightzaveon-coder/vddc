local function Create(class, props, children)
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			inst[k] = v
		end
		local face = props.Font ~= nil and APADFontFaces[props.Font]
		if face then inst.FontFace = face end
	end
	if class == "ScrollingFrame" then
		if not props or props.Active == nil then inst.Active = true end
		if not props or props.ScrollingEnabled == nil then inst.ScrollingEnabled = true end
		if not props or props.ScrollingDirection == nil then inst.ScrollingDirection = Enum.ScrollingDirection.Y end
		if not props or props.ElasticBehavior == nil then inst.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable end
		if UserInputService.TouchEnabled and (not props or props.ScrollBarThickness == nil) then
			inst.ScrollBarThickness = 5
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	return inst
end

local function AddCorner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 3)
	c.Parent = parent
	return c
end

local function AddStroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Border
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function AddPadding(parent, all, left, right, top, bottom)
	local p = Instance.new("UIPadding")
	if all then
		p.PaddingLeft   = UDim.new(0, all)
		p.PaddingRight  = UDim.new(0, all)
		p.PaddingTop    = UDim.new(0, all)
		p.PaddingBottom = UDim.new(0, all)
	end
	if left   then p.PaddingLeft   = UDim.new(0, left)   end
	if right  then p.PaddingRight  = UDim.new(0, right)  end
	if top    then p.PaddingTop    = UDim.new(0, top)    end
	if bottom then p.PaddingBottom = UDim.new(0, bottom) end
	p.Parent = parent
	return p
end

local function AddListLayout(parent, dir, pad, ha, va)
	local l = Instance.new("UIListLayout")
	l.FillDirection = dir or Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, pad or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.HorizontalAlignment = ha or Enum.HorizontalAlignment.Left
	l.VerticalAlignment = va or Enum.VerticalAlignment.Top
	l.Parent = parent
	return l
end

local function AddCornerBrackets(parent, color, size, thickness)
	do return end
	color = color or Theme.Accent
	size = size or 8
	thickness = thickness or 1
	local function corner(name, x, y)
		local h = Create("Frame", {
			Name = name,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(size, size),
			AnchorPoint = Vector2.new(x, y),
			Position = UDim2.new(x, x == 0 and 2 or -2, y, y == 0 and 2 or -2),
			ZIndex = (parent.ZIndex or 1) + 1,
			Parent = parent,
		})
		local horiz = Create("Frame", {
			BackgroundColor3 = color, BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, thickness),
			Position = UDim2.new(0, 0, y, y == 0 and 0 or -thickness),
			ZIndex = h.ZIndex, Parent = h,
		})
		local vert = Create("Frame", {
			BackgroundColor3 = color, BorderSizePixel = 0,
			Size = UDim2.new(0, thickness, 1, 0),
			Position = UDim2.new(x, x == 0 and 0 or -thickness, 0, 0),
			ZIndex = h.ZIndex, Parent = h,
		})
		return { Horiz = horiz, Vert = vert }
	end
	corner("TL", 0, 0)
	corner("TR", 1, 0)
	corner("BR", 1, 1)
	corner("BL", 0, 1)
end

