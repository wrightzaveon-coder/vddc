		BackgroundTransparency = 1, Font = State.FontMedium, TextSize = 13,
		TextColor3 = Theme.MainText, Text = label,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -64, 1, 0), ZIndex = 7, Parent = holder,
	})
	local track = Create("TextButton", {
		AutoButtonColor = false, BackgroundColor3 = Theme.Secondary, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(46, 22), Text = "", ZIndex = 7, Parent = holder,
	})
	AddCorner(track, 11)
	AddStroke(track, Theme.Border, 1, 0.2)
	local knob = Create("Frame", {
		BackgroundColor3 = Theme.Disabled, BorderSizePixel = 0,
		Position = UDim2.fromOffset(2, 2), Size = UDim2.fromOffset(18, 18),
		ZIndex = 8, Parent = track,
	})
	AddCorner(knob, 99)
	local value = default and true or false
	local function apply(v, animate)
		value = v
		local knobPos = v and UDim2.new(1, -20, 0, 2) or UDim2.fromOffset(2, 2)
		local knobColor = v and Theme.BrightGreen or Theme.Disabled
		local trackColor = v and Theme.Accent or Theme.Secondary
		if animate then
			tween(knob, 0.15, { Position = knobPos, BackgroundColor3 = knobColor })
			tween(track, 0.15, { BackgroundColor3 = trackColor })
		else
			knob.Position = knobPos; knob.BackgroundColor3 = knobColor; track.BackgroundColor3 = trackColor
		end
	end
	apply(value, false)
	track.Activated:Connect(function()
		apply(not value, true)
		if callback then pcall(callback, value) end
	end)
	subscribeAccent(function(c) if value then track.BackgroundColor3 = c end end)
	return { Set = function(_, v) apply(v, true); if callback then pcall(callback, v) end end, Get = function() return value end, Frame = holder }
end

function Components.CreateSlider(parent, label, minV, maxV, default, callback)
	local holder = Create("Frame", {
		BackgroundColor3 = Theme.Raised, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 56), ZIndex = 6, Parent = parent,
	})
	AddCorner(holder, 6)
	AddStroke(holder, Theme.Border, 1, 0.3)
	AddPadding(holder, nil, 12, 12, 8, 8)
	Create("TextLabel", {
		BackgroundTransparency = 1, Font = State.FontMedium, TextSize = 12,
		TextColor3 = Theme.MainText, Text = label,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.7, 0, 0, 16), ZIndex = 7, Parent = holder,
	})
	local val = Create("TextLabel", {
		BackgroundTransparency = 1, Font = State.FontBold, TextSize = 12,
		TextColor3 = Theme.Accent, Text = tostring(default),
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0.7, 0, 0, 0), Size = UDim2.new(0.3, 0, 0, 16),
		ZIndex = 7, Parent = holder,
	})
	subscribeAccent(function(c) val.TextColor3 = c end)
	local track = Create("Frame", {
		BackgroundColor3 = Theme.Secondary, BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 26), Size = UDim2.new(1, 0, 0, 6),
		ZIndex = 7, Parent = holder,
	})
	AddCorner(track, 3)
	local fill = Create("Frame", {
		BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 1, 0), ZIndex = 8, Parent = track,
	})
	AddCorner(fill, 3)
	subscribeAccent(function(c) fill.BackgroundColor3 = c end)
	local knob = Create("Frame", {
		BackgroundColor3 = Theme.MainText, BorderSizePixel = 0,
		Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, -7, 0.5, -7),
		ZIndex = 9, Parent = track,
	})
	AddCorner(knob, 99)
	AddStroke(knob, Theme.Border, 1, 0.2)
	local minR, maxR = tonumber(minV) or 0, tonumber(maxV) or 100
	local value = tonumber(default) or minR
	local dragging = false
	local function apply(v, fireCb)
		v = math.clamp(v, minR, maxR)
		local ratio = (v - minR) / math.max(maxR - minR, 0.0001)
		value = v
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		knob.Position = UDim2.new(ratio, -7, 0.5, -7)
		local decimals = (maxR - minR) <= 3 and 2 or 0
		val.Text = string.format("%." .. decimals .. "f", v)
		if fireCb and callback then pcall(callback, v) end
	end
	apply(value, false)
	local function setFromX(px)
		local abs = track.AbsolutePosition.X
		local w = track.AbsoluteSize.X
		local ratio = math.clamp((px - abs) / math.max(w, 1), 0, 1)
		apply(minR + (maxR - minR) * ratio, true)
	end
	local input = Create("TextButton", {
		AutoButtonColor = false, BackgroundTransparency = 1, Text = "",
		Position = UDim2.new(0, 0, 0, 20), Size = UDim2.new(1, 0, 0, 20),
		ZIndex = 10, Parent = holder,
	})
	input.InputBegan:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
			dragging = true; setFromX(io.Position.X)
		end
	end)
	input.InputEnded:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	trackConn(UserInputService.InputChanged:Connect(function(io)
		if dragging and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then
			setFromX(io.Position.X)
		end
	end))
	return { Set = function(_, v) apply(v, true) end, Get = function() return value end, Frame = holder }
end

function Components.CreateDropdown(parent, label, options, default, callback)
	local dropdownOptions = {}
	for _, v in ipairs(type(options) == "table" and options or {}) do table.insert(dropdownOptions, v) end
	local optionHeight = UserInputService.TouchEnabled and 40 or 32
	local maxVisible = UserInputService.TouchEnabled and 5 or 6
	local holder = Create("Frame", {
		BackgroundColor3 = Theme.Raised, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 60), ZIndex = 6, Parent = parent,
	})
	AddCorner(holder, 6)
	AddStroke(holder, Theme.Border, 1, 0.3)
	AddPadding(holder, nil, 12, 12, 8, 8)
	Create("TextLabel", {
		BackgroundTransparency = 1, Font = State.FontMedium, TextSize = 12,
		TextColor3 = Theme.MainText, Text = label,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, 0, 0, 16), ZIndex = 7, Parent = holder,
	})
	local btn = Create("TextButton", {
		AutoButtonColor = false, BackgroundColor3 = Theme.Secondary, BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 20), Size = UDim2.new(1, 0, 0, 30),
		Font = State.FontMain, TextSize = 13, TextColor3 = Theme.MainText,
		Text = tostring(default or dropdownOptions[1] or "No options"),
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 22, Parent = holder,
	})
	AddCorner(btn, 5)
	AddPadding(btn, nil, 10, 22, 0, 0)
	AddStroke(btn, Theme.Border, 1, 0.2)
	local arrow = Create("TextLabel", {
		BackgroundTransparency = 1, Font = State.FontBold, TextSize = 12,
		TextColor3 = Theme.Accent, Text = "\u{25BE}",
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(14, 14), ZIndex = 23, Parent = btn,
	})
	subscribeAccent(function(c) arrow.TextColor3 = c end)
	local list = Create("ScrollingFrame", {
		BackgroundColor3 = Theme.Panel, BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 0, 52), Size = UDim2.new(1, 0, 0, 0),
		CanvasSize = UDim2.new(0, 0, 0, #dropdownOptions * optionHeight),
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = UserInputService.TouchEnabled and 6 or 3,
		ScrollBarImageColor3 = Theme.Border,
		Visible = false, ClipsDescendants = true, ZIndex = 25, Parent = holder,
	})
	AddCorner(list, 5)
	AddStroke(list, Theme.Accent, 1, 0.25)
	AddListLayout(list, Enum.FillDirection.Vertical, 0)
	local selected = default or dropdownOptions[1]
	local isOpen = false
	local closeSelf
	local function resizeOpenList()
		local vh = math.min(#dropdownOptions, maxVisible) * optionHeight
		list.CanvasSize = UDim2.new(0, 0, 0, #dropdownOptions * optionHeight)
		list.Size = UDim2.new(1, 0, 0, vh)
		holder.Size = UDim2.new(1, 0, 0, 60 + vh + 4)
	end
	local function openD()
		if OpenDropdown and OpenDropdown ~= closeSelf then OpenDropdown() end
		OpenDropdown = closeSelf
		isOpen = true; list.Visible = true; resizeOpenList(); arrow.Text = "\u{25B4}"
	end
	closeSelf = function()
		isOpen = false; list.Size = UDim2.new(1, 0, 0, 0); holder.Size = UDim2.new(1, 0, 0, 60)
		list.Visible = false; arrow.Text = "\u{25BE}"
		if OpenDropdown == closeSelf then OpenDropdown = nil end
	end
	local function rebuildOptions(values)
		local next_ = {}
		for _, v in ipairs(type(values) == "table" and values or {}) do table.insert(next_, v) end
		dropdownOptions = next_
		for _, c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
		local still = false
		for _, v in ipairs(dropdownOptions) do if v == selected then still = true; break end end
		if not still then selected = dropdownOptions[1] end
		btn.Text = tostring(selected or "No options")
		for _, opt in ipairs(dropdownOptions) do
			local ob = Create("TextButton", {
				AutoButtonColor = false, BackgroundColor3 = Theme.Panel, BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, optionHeight),
				Font = State.FontMain, TextSize = 13, TextColor3 = Theme.MainText,
				Text = tostring(opt), TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 26, Parent = list,
			})
			AddPadding(ob, nil, 10, 10, 0, 0)
			ob.MouseEnter:Connect(function() ob.BackgroundColor3 = Theme.Raised end)
			ob.MouseLeave:Connect(function() ob.BackgroundColor3 = Theme.Panel end)
			ob.Activated:Connect(function()
				selected = opt; btn.Text = tostring(opt); closeSelf()
				if callback then pcall(callback, opt) end
			end)
		end
		list.CanvasSize = UDim2.new(0, 0, 0, #dropdownOptions * optionHeight)
		if isOpen then resizeOpenList() end
	end
	rebuildOptions(dropdownOptions)
	btn.Activated:Connect(function() if isOpen then closeSelf() else openD() end end)
	return {
		Set = function(_, v) selected = v; btn.Text = tostring(v); if callback then pcall(callback, v) end end,
		SetValues = function(_, v) rebuildOptions(v) end,
		Refresh = function(_, v) rebuildOptions(v) end,
		UpdateList = function(_, v) rebuildOptions(v) end,
		Get = function() return selected end,
		Frame = holder,
	}
end

