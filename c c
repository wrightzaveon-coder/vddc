    end

    local function ownedVehicle()
        local player = game:GetService("Players").LocalPlayer
        local cars = workspace:FindFirstChild("CivCars")
        local models = cars and cars:GetChildren() or workspace:GetChildren()
        for _, model in ipairs(models) do
            if model:IsA("Model") then
                local owner = model:FindFirstChild("Owner", true)
                local ownerValue = owner and owner.Value
                local mine = ownerValue == player
                    or ownerValue == player.Name
                    or tostring(ownerValue) == player.Name
                if mine then
                    local seat = model:FindFirstChild("DriveSeat", true)
                        or model:FindFirstChildWhichIsA("VehicleSeat", true)
                    if seat then return seat, model end
                end
            end
        end
    end

    local function setVehiclePrimaryPart(model)
        if not model or not model:IsA("Model") then return end
        if not model.PrimaryPart then
            local body = model:FindFirstChild("Body")
            model.PrimaryPart = body and body:FindFirstChild("#Weight", true)
                or (body and body:FindFirstChildWhichIsA("BasePart", true))
                or model:FindFirstChildWhichIsA("BasePart", true)
        end
        return model.PrimaryPart
    end

