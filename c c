        for _, connection in ipairs(getgenv()._ScorpioHubAntiFlingTouches) do
            pcall(function() connection:Disconnect() end)
        end
    end

    local antiFlingTouches = {}
    local antiFlingCharacter
    local antiFlingReturning = false
    getgenv()._ScorpioHubAntiFlingTouches = antiFlingTouches

    local function clearAntiFlingTouches()
        for _, connection in ipairs(antiFlingTouches) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(antiFlingTouches)
        antiFlingCharacter = nil
    end

    local function cleanFlingForces(part)
        if not part then return end
        for _, force in ipairs(part:GetChildren()) do
            if force:IsA("BodyVelocity")
                or force:IsA("LinearVelocity")
                or force:IsA("VectorForce")
                or force:IsA("BodyForce")
                or force:IsA("BodyGyro")
                or force:IsA("BodyAngularVelocity")
                or force:IsA("AngularVelocity") then
                pcall(function() force:Destroy() end)
            end
        end
    end

    local function installAntiFlingTouch(character)
        if not character or antiFlingCharacter == character then return end
        clearAntiFlingTouches()
        antiFlingCharacter = character
        for _, partName in ipairs({
            "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso",
            "Head", "Left Leg", "Right Leg"
        }) do
            local bodyPart = character:FindFirstChild(partName)
            if bodyPart and bodyPart:IsA("BasePart") then
                table.insert(antiFlingTouches, bodyPart.Touched:Connect(function(hit)
                    if not getgenv().antiFlingSuper or not hit or hit:IsDescendantOf(character) or hit.Anchored then return end
                    local model = hit:FindFirstAncestorOfClass("Model")
                    local otherPlayer = model and game:GetService("Players"):GetPlayerFromCharacter(model)
                    local vehicle = hit:IsA("VehicleSeat")
                        or (model and (model:FindFirstChildOfClass("VehicleSeat")
                        or model.Name == "CivCars"
                        or (model.Parent and model.Parent.Name == "CivCars")))
                    if not otherPlayer and not vehicle then return end
                    if otherPlayer == game:GetService("Players").LocalPlayer then return end
                    local root = character:FindFirstChild("HumanoidRootPart")
                    if not root then return end
                    local direction = hit.Position - root.Position
                    if direction.Magnitude == 0 then direction = Vector3.new(1, 0, 0) end
                    direction = direction.Unit
                    pcall(function()
                        hit.AssemblyLinearVelocity = direction * 800 + Vector3.new(0, 400, 0)
                        hit.AssemblyAngularVelocity = Vector3.new(
                            math.random(-50, 50),
                            math.random(-50, 50),
                            math.random(-50, 50)
                        )
                    end)
                    if otherPlayer and otherPlayer.Character then
                        for _, part in ipairs(otherPlayer.Character:GetDescendants()) do
                            if part:IsA("BasePart") then
                                pcall(function()
                                    part.AssemblyLinearVelocity = direction * 600 + Vector3.new(0, 400, 0)
                                end)
                            end
                        end
                    end
                end))
            end
        end
    end

    local function stopFlingMotion(character)
        if not character then return end
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                cleanFlingForces(part)
                pcall(function()
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end
    end

    local function isFlingVelocity(root, super)
        local velocity = root.AssemblyLinearVelocity
        local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
        local vertical = math.abs(velocity.Y)
        local angular = root.AssemblyAngularVelocity.Magnitude
        if super then
            return horizontal > 60 or vertical > 125 or angular > 40
        end
        return horizontal > 95 or vertical > 165 or angular > 55
    end

    local function returnFromFling(character, humanoid, root)
        local destination = getgenv()._antiFlingLastSafePos
        if not destination or antiFlingReturning then return end
        antiFlingReturning = true
        stopFlingMotion(character)
        pcall(function()
            root.CFrame = destination
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
        task.spawn(function()
            for _ = 1, 3 do
                game:GetService("RunService").Heartbeat:Wait()
                if not character.Parent or not root.Parent then break end
                stopFlingMotion(character)
                pcall(function() root.CFrame = destination end)
            end
            antiFlingReturning = false
        end)
    end

    getgenv()._ScorpioHubAntiFlingHeartbeat = game:GetService("RunService").Heartbeat:Connect(function()
        local player = game:GetService("Players").LocalPlayer
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not character or not humanoid or not root then return end

        if getgenv().anchorPlayerToGround then
            root.Anchored = true
        end
        if not getgenv().antiFling and not getgenv().antiFlingSuper then return end
        local super = getgenv().antiFlingSuper
        local flingDetected = isFlingVelocity(root, super)

        if super then
            installAntiFlingTouch(character)
            cleanFlingForces(root)
            cleanFlingForces(character:FindFirstChild("UpperTorso"))
            cleanFlingForces(character:FindFirstChild("LowerTorso"))
            cleanFlingForces(character:FindFirstChild("Torso"))
        end

        if flingDetected then
            returnFromFling(character, humanoid, root)
            return
        end

        local velocity = root.AssemblyLinearVelocity
        local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
        if not antiFlingReturning
            and humanoid.FloorMaterial ~= Enum.Material.Air
            and horizontal < 40
            and math.abs(velocity.Y) < 35
            and root.AssemblyAngularVelocity.Magnitude < 20 then
            getgenv()._antiFlingLastSafePos = root.CFrame
        end
    end)

