local function ensureHitSoundRuntime()
    if getgenv()._ScorpioHubHitSoundConnections then return true end

    local connections = {}
    local boundTools = setmetatable({}, {__mode = "k"})
    local watchedHumanoids = setmetatable({}, {__mode = "k"})
    getgenv()._ScorpioHubHitSoundConnections = connections
    getgenv()._ScorpioHubHitSoundBoundTools = boundTools
    getgenv()._ScorpioHubHitSoundHumanoids = watchedHumanoids

    local function addConnection(connection)
        if connection then table.insert(connections, connection) end
    end

    local function bindTool(tool)
        if not tool or not tool:IsA("Tool") or boundTools[tool] then return end
        if not tool:FindFirstChild("GunScript_Local") and not tool:FindFirstChild("GunScript_Server") then return end
        boundTools[tool] = true
        addConnection(tool.Activated:Connect(function()
            if ScorpioHubAlive() and getgenv().HitSoundsEnabled then
                getgenv()._ScorpioHubLastLocalGunShot = os.clock()
            end
        end))
    end

    local function bindLocalCharacter(character)
        if not character then return end
        for _, child in ipairs(character:GetChildren()) do
            bindTool(child)
        end
        addConnection(character.ChildAdded:Connect(bindTool))
    end

    local function watchHumanoid(humanoid)
        if not humanoid or watchedHumanoids[humanoid] then return end
        watchedHumanoids[humanoid] = true
        local lastHealth = humanoid.Health
        addConnection(humanoid.HealthChanged:Connect(function(health)
            local previousHealth = lastHealth
            lastHealth = health
            if not ScorpioHubAlive() or not getgenv().HitSoundsEnabled then return end
            if health >= previousHealth then return end
            local lastShot = getgenv()._ScorpioHubLastLocalGunShot or 0
            if os.clock() - lastShot > 1 then return end
            local now = os.clock()
            if now - (getgenv()._ScorpioHubLastHitSound or 0) < 0.04 then return end
            getgenv()._ScorpioHubLastHitSound = now
            local playHitSound = getgenv().PlayHitSound
            if playHitSound then task.spawn(playHitSound) end
        end))
    end

    local function watchTargetCharacter(character)
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then watchHumanoid(humanoid) end
        addConnection(character.ChildAdded:Connect(function(child)
            if child:IsA("Humanoid") then watchHumanoid(child) end
        end))
    end

    local function watchPlayer(player)
        if player == LocalPlayer then return end
        watchTargetCharacter(player.Character)
        addConnection(player.CharacterAdded:Connect(watchTargetCharacter))
    end

    bindLocalCharacter(LocalPlayer.Character)
    addConnection(LocalPlayer.CharacterAdded:Connect(bindLocalCharacter))
    for _, player in ipairs(Players:GetPlayers()) do
        watchPlayer(player)
    end
    addConnection(Players.PlayerAdded:Connect(watchPlayer))
    return true
end

