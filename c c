local function SwitchPage(id)
	if not State.Pages[id] then return end
	if not State.Booting and _G.__SCORPIO_LoadPageFeatures then
		_G.__SCORPIO_LoadPageFeatures(id)
	end
	for pid, page in pairs(State.Pages) do
		if pid ~= id then page.Frame.Visible = false end
	end
	local page = State.Pages[id]
	page.Frame.Visible = true
	page.Frame.Position = UDim2.new(0, 10, 0, 0)
	tween(page.Frame, 0.15, { Position = UDim2.new(0, 0, 0, 0) })
	State.CurrentPage = id

	for pid, ref in pairs(sidebarButtons) do
		if pid == id then
			ref.Button.BackgroundTransparency = 0
			ref.Button.BackgroundColor3 = Color3.fromRGB(40, 0, 0)
			ref.Button.TextColor3 = Theme.MainText
			ref.LeftLine.Visible = true
			ref.ActiveTag.Visible = true
		else
			ref.Button.BackgroundTransparency = 1
			ref.Button.TextColor3 = Theme.Muted
			ref.LeftLine.Visible = false
			ref.ActiveTag.Visible = false
		end
	end

	for tid, ref in pairs(tabButtons) do
		if tid == id then
			ref.Tab.BackgroundColor3 = Theme.MainWindow
			ref.Name.TextColor3 = Theme.MainText
			ref.TopLine.Visible = true
			ref.Dot.BackgroundColor3 = Theme.Accent
		else
			ref.Tab.BackgroundColor3 = Theme.Secondary
			ref.Name.TextColor3 = Theme.Muted
			ref.TopLine.Visible = false
			ref.Dot.BackgroundColor3 = Theme.Muted
		end
	end
end
_G.__SCORPIO_SwitchPage = SwitchPage

local TerminalScroll
local TerminalLines = {}

local function timestamp()
	if not Config.TerminalTimestamps then return "" end
	local t = os.clock() - State.StartTime
	return string.format("<font color='#385648'>[%02d:%02d]</font> ", math.floor(t / 60) % 60, math.floor(t) % 60)
end

local function AddTerminalLine(text, kind)
	if not TerminalScroll then return end
	local colors = {
		boot = "#00F5D4", auth = "#FFA726", net = "#00FF66",
		scan = "#00F5D4", info = "#D2FFE4", err = "#FF495C",
		ready = "#00FF66", cmd = "#D2FFE4", ok = "#00FF66",
	}
	local hex = colors[kind] or "#D2FFE4"
	local lbl = Create("TextLabel", {
		BackgroundTransparency = 1,
		Font = State.FontMain, TextSize = 12,
		TextColor3 = Theme.MainText,
		Text = timestamp() .. string.format("<font color='%s'>%s</font>", hex, text),
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -6, 0, 16),
		RichText = true,
		Parent = TerminalScroll,
	})
	table.insert(TerminalLines, lbl)
	if #TerminalLines > 200 then
		TerminalLines[1]:Destroy()
		table.remove(TerminalLines, 1)
	end
	task.defer(function()
		if TerminalScroll and TerminalScroll.Parent then
			TerminalScroll.CanvasPosition = Vector2.new(0, TerminalScroll.AbsoluteCanvasSize.Y)
		end
	end)
end
_G.__SCORPIO_AddTerminalLine = AddTerminalLine

