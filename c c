local function clearSilentAimRuntime()
    local connections = getgenv()._ScorpioHubVroySilentToolConnections
    if connections then
        for _, connection in ipairs(connections) do
            pcall(function() connection:Disconnect() end)
        end
    end
    getgenv()._ScorpioHubVroySilentToolConnections = nil
    getgenv()._ScorpioHubSilentBoundTools = nil
end

local function ensureSilentAimRuntime()
    if getgenv()._ScorpioHubVroySilentToolConnections then return true end

    local connections = {}
    local boundTools = setmetatable({}, {__mode = "k"})
    getgenv()._ScorpioHubVroySilentToolConnections = connections
    getgenv()._ScorpioHubSilentBoundTools = boundTools

    local function bindTool(tool)
        if not tool or not tool:IsA("Tool") or boundTools[tool] then return end
        if not tool:FindFirstChild("GunScript_Local") and not tool:FindFirstChild("GunScript_Server") then return end
        boundTools[tool] = true
        table.insert(connections, tool.Activated:Connect(function()
            if not ScorpioHubAlive() or not SASettings.SilentAimEnabled then return end
            local now = os.clock()
            if now - (getgenv()._ScorpioHubSilentLastShot or 0) < 0.08 then return end
            getgenv()._ScorpioHubSilentLastShot = now
            task.defer(function()
                if ScorpioHubAlive() and SASettings.SilentAimEnabled then
                    silent_kill(true)
                end
            end)
        end))
    end

    local function bindCharacter(character)
        if not character then return end
        for _, child in ipairs(character:GetChildren()) do
            bindTool(child)
        end
        table.insert(connections, character.ChildAdded:Connect(bindTool))
    end

    bindCharacter(LocalPlayer.Character)
    table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(character)
        task.defer(function()
            bindCharacter(character)
        end)
    end))
    return true
end

