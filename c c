local function applyBulletVisuals(t)
    if typeof(t) ~= "table" or not rawget(t, "BulletSpeed") then
        return
    end

    saveOriginals(t)

    rawset(t, "BulletSpeed", 150)
    rawset(t, "DropGravity", 0.3)
    rawset(t, "BulletParticleEnaled", true)
    rawset(t, "BulletParticleColor", Color3.new(1, 0, 0))
    rawset(t, "BulletParticleSize", NumberSequence.new({
        NumberSequenceKeypoint.new(0, 9e9),
        NumberSequenceKeypoint.new(1, 1)
    }))
end

local function restoreOriginals()
    for t, original in pairs(modifiedTables) do
        pcall(function()
            rawset(t, "BulletSpeed", original.BulletSpeed)
            rawset(t, "DropGravity", original.DropGravity)
            rawset(t, "BulletParticleEnaled", original.BulletParticleEnaled)
            rawset(t, "BulletParticleColor", original.BulletParticleColor)
            rawset(t, "BulletParticleSize", original.BulletParticleSize)
        end)
    end

    modifiedTables = {}
end

