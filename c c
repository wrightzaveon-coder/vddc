ContinueBtn.Activated:Connect(function()
	if LockState.Step == 1 then if LockState.CableConnected then goToStep(2) end
	elseif LockState.Step == 2 then if LockState.Make then goToStep(3) end
	elseif LockState.Step == 3 then if LockState.Model then goToStep(4) end
	elseif LockState.Step == 4 then if LockState.Year then goToStep(5) end
	elseif LockState.Step == 6 then
		local t = TweenService:Create(LockOverlay, tweenInfo(0.25), { BackgroundTransparency = 1 })
		t:Play()
