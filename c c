        Callback = function()
            task.spawn(function()
                local player = game:GetService("Players").LocalPlayer
                local character = player.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local selected = getgenv().ScorpioHubCarState.selected
                if not root or not humanoid or not selected then return end
                if not replicatesignal then
                    Notifier.new({Title="Car Spawn",Content="Executor does not support replicatesignal.",Duration=4})
                    return
                end
                local original = root.CFrame
                local dealer = workspace:FindFirstChild("CARDealerP")
                if dealer then ScorpioHubBypassTP(dealer.CFrame) end
                local gui = player.PlayerGui:WaitForChild("GunGui", 8)
                local list = gui and gui:FindFirstChild("Holder") and gui.Holder:FindFirstChild("ScrollingFrame")
                local item = list and list:FindFirstChild(selected)
                local buy = gui and gui.Holder:FindFirstChild("Buy")
                if not item or not buy then
                    Notifier.new({Title="Car Spawn",Content="Vehicle was not found in the dealer.",Duration=4})
                    ScorpioHubBypassTP(original)
                    return
                end
                replicatesignal(item.MouseButton1Down, 1, 1)
                task.wait(0.5)
                if tostring(buy.Text):lower() == "buy" then
                    Notifier.new({Title="Car Spawn",Content="You do not own this vehicle.",Duration=4})
                    ScorpioHubBypassTP(original)
                    return
                end
                local cars = workspace:FindFirstChild("CivCars")
                if not cars then
                    Notifier.new({Title="Car Spawn",Content="CivCars folder was not found.",Duration=4})
                    ScorpioHubBypassTP(original)
                    return
                end
                local spawnedCar
                local spawnConnection
                spawnConnection = cars.ChildAdded:Connect(function(child)
                    task.spawn(function()
                        local _, ownedModel = waitForOwnedSpawn(child, 10)
                        if ownedModel and not spawnedCar then spawnedCar = ownedModel end
                    end)
                end)
                replicatesignal(buy.MouseButton1Down, 1, 1)
                local deadline = os.clock() + 12
                repeat task.wait(0.1) until spawnedCar or os.clock() >= deadline
                if spawnConnection then spawnConnection:Disconnect() end
                ScorpioHubBypassTP(original)
                if not spawnedCar then
                    Notifier.new({Title="Car Spawn",Content="Owned vehicle did not appear in time.",Duration=5})
                    return
                end
                local seat = spawnedCar:FindFirstChild("DriveSeat", true)
                    or spawnedCar:FindFirstChildWhichIsA("VehicleSeat", true)
                if getgenv().ScorpioHubCarState.autoBring then
                    bringVehicle(spawnedCar, original + Vector3.new(0, 5, 0))
                    task.wait(0.2)
                end
                if getgenv().ScorpioHubCarState.autoGetIn and seat then seatInVehicle(seat) end
                Notifier.new({Title="Car Spawn",Content="Owned vehicle spawned successfully.",Duration=3})
            end)
        end
    })

