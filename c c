    function ScorpioHubSafeRequire(module)
        if not module then return nil end
        local ok, result = pcall(require, module)
        if ok and type(result) == "table" then return result end
        return setmetatable({}, {
            __index = function(_, key)
                local value = module:FindFirstChild(key)
                return value and value:IsA("ValueBase") and value.Value or nil
            end,
            __newindex = function(_, key, value)
                local child = module:FindFirstChild(key)
                if child and child:IsA("ValueBase") then
                    pcall(function() child.Value = value end)
                end
            end,
        })
    end

    function checkgun()
        local player = Players.LocalPlayer
        local gunTool
        if player.Character then
            for _, tool in ipairs(player.Character:GetChildren()) do
                if tool:IsA("Tool")
                    and (tool:FindFirstChild("GunScript_Local") or tool:FindFirstChild("GunScript_Server")) then
                    gunTool = tool
                    break
                end
            end
        end
        if not gunTool then
            for _, tool in ipairs(player.Backpack:GetChildren()) do
                if tool:IsA("Tool")
                    and (tool:FindFirstChild("GunScript_Local") or tool:FindFirstChild("GunScript_Server")) then
                    gunTool = tool
                    break
                end
            end
        end
        if gunTool and gunTool.Parent ~= player.Character and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then humanoid:EquipTool(gunTool); task.wait(0.3) end
