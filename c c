local function _makeAPADProxy(record)
	local proxy = {}
	function proxy:Set(value)
		record.opts.Default = value
		if type(record.live) == "table" and record.live.Set then record.live:Set(value) end
	end
	function proxy:Get()
		if type(record.live) == "table" and record.live.Get then return record.live:Get() end
		return record.opts.Default
	end
	function proxy:SetContent(value)
		record.opts.Content = tostring(value or "")
		if type(record.live) == "table" and record.live.SetContent then record.live:SetContent(record.opts.Content) end
	end
	function proxy:SetTitle(value)
		record.opts.Title = tostring(value or "")
		if type(record.live) == "table" and record.live.SetTitle then record.live:SetTitle(record.opts.Title) end
	end
	function proxy:SetText(value)
		record.opts.Name = tostring(value or "")
		if type(record.live) == "table" and record.live.SetText then
			record.live:SetText(record.opts.Name)
		elseif typeof(record.live) == "Instance" then
			pcall(function() record.live.Text = record.opts.Name end)
		end
	end
	function proxy:SetValues(values)
		record.opts.Values = values or {}
		if type(record.live) == "table" and record.live.SetValues then
			record.live:SetValues(record.opts.Values)
		end
	end
	proxy.UpdateList = proxy.SetValues
	proxy.Refresh = proxy.SetValues
	function proxy:Destroy()
		record.destroyed = true
		local live = record.live
		if live and live.Destroy then
			pcall(function() live:Destroy() end)
		elseif live and live.Frame then
			pcall(function() live.Frame:Destroy() end)
		end
	end
	return proxy
end

local function _mountAPADControl(record, content)
	if record.destroyed then return end
	local o = record.opts
	local live
	if record.kind == "button" then
		live = Components.CreateButton(content, tostring(o.Name or "Button"), o.Callback)
	elseif record.kind == "toggle" then
		live = Components.CreateToggle(content, tostring(o.Name or "Toggle"), o.Default and true or false, o.Callback)
	elseif record.kind == "slider" then
		local mn = tonumber(o.Min or o.Minimum) or 0
		local mx = tonumber(o.Max or o.Maximum) or 100
		local df = tonumber(o.Default) or mn
		live = Components.CreateSlider(content, tostring(o.Name or "Slider"), mn, mx, df, o.Callback)
	elseif record.kind == "dropdown" then
		local opts = o.Values or o.Options or {}
		live = Components.CreateDropdown(content, tostring(o.Name or "Dropdown"), opts, o.Default, o.Callback)
	elseif record.kind == "textbox" then
		live = Components.CreateTextbox(content, tostring(o.Name or "Textbox"), o.Placeholder or "", o.Callback)
	elseif record.kind == "color" then
		local presets = { "Red", "Orange", "Yellow", "Green", "Cyan", "Blue", "Purple", "Pink", "White", "Black" }
		local map = {
			Red = Color3.fromRGB(255, 0, 0), Orange = Color3.fromRGB(255, 140, 0),
			Yellow = Color3.fromRGB(255, 235, 0), Green = Color3.fromRGB(0, 255, 60),
			Cyan = Color3.fromRGB(0, 220, 255), Blue = Color3.fromRGB(30, 90, 255),
			Purple = Color3.fromRGB(170, 0, 255), Pink = Color3.fromRGB(255, 105, 180),
			White = Color3.fromRGB(255, 255, 255), Black = Color3.fromRGB(0, 0, 0),
		}
		live = Components.CreateDropdown(content, tostring(o.Name or "Color") .. " (preset)", presets, "Red", function(value)
			if type(o.Callback) == "function" and map[value] then pcall(o.Callback, map[value]) end
		end)
	elseif record.kind == "paragraph" then
		local label = Create("TextLabel", {
			BackgroundTransparency = 1,
			Font = State.FontMain,
			TextSize = 11,
			TextColor3 = Theme.Muted,
			Text = tostring(o.Title or "") .. (o.Content and ("\n" .. tostring(o.Content)) or ""),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 40),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = content,
		})
		live = {
			Frame = label,
			SetContent = function(_, value)
				label.Text = tostring(o.Title or "") .. "\n" .. tostring(value or "")
			end,
			SetTitle = function(_, value)
				label.Text = tostring(value or "") .. (o.Content and ("\n" .. tostring(o.Content)) or "")
			end,
			SetText = function(_, value) label.Text = tostring(value or "") end,
		}
	elseif record.kind == "keybind" then
		live = Components.CreateButton(content, "[keybind] " .. tostring(o.Name or ""), o.PressedCallback)
	elseif record.kind == "separator" then
		live = Create("Frame", {
			BackgroundColor3 = Theme.Border,
			BackgroundTransparency = 0.4,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 1),
			Parent = content,
		})
	end
	record.live = live
	if typeof(live) == "Instance" then
		record.proxy.Frame = live
	elseif type(live) == "table" then
		record.proxy.Frame = live.Frame
	end
end

local function _makeAPADSection(hostScroll, tabName, sectionName, pageId)
	_APAD_SEC_ORDER = _APAD_SEC_ORDER + 1
	pageId = pageId or "main"
	local sectionRecord = {
		host = hostScroll,
		pageId = pageId,
		tabName = tabName,
		sectionName = sectionName,
		order = _APAD_SEC_ORDER,
		controls = {},
	}
	_APAD_PENDING[pageId] = _APAD_PENDING[pageId] or {}
	table.insert(_APAD_PENDING[pageId], sectionRecord)
	local s = { _tab = tabName, _sec = sectionName, _record = sectionRecord }
	local function add(kind, options)
		_paceAPADBuild()
		local record = { kind = kind, opts = options or {} }
		record.proxy = _makeAPADProxy(record)
		table.insert(sectionRecord.controls, record)
		return record.proxy
	end
	function s:AddButton(o)
		return add("button", o)
	end
	function s:AddToggle(o)
		return add("toggle", o)
	end
	function s:AddSlider(o)
		return add("slider", o)
	end
	function s:AddDropdown(o)
		return add("dropdown", o)
	end
	function s:AddTextBox(o)
		return add("textbox", o)
	end
	s.AddTextbox = s.AddTextBox
	s.Addtextbox = s.AddTextBox
	function s:AddColorPicker(o)
		return add("color", o)
	end
	function s:AddParagraph(o)
		return add("paragraph", o)
	end
	function s:AddKeybind(o)
		return add("keybind", o)
	end
	function s:AddSeparator()
		return add("separator", {})
	end
	s.AddLabel = s.AddParagraph
	s.Addlabel = s.AddParagraph
	return s
end

local function _makeAPADTab(tabName)
	local host = _resolveAPADHost(tabName)
	local pageId = _APAD_ROUTE[tostring(tabName)] or "main"
	local tab = { _name = tabName, _host = host, _pageId = pageId }
	function tab:DrawSection(o)
		o = o or {}
		return _makeAPADSection(self._host, self._name, tostring(o.Name or "Section"), self._pageId)
	end
	function tab:CreateCard(o)
		o = o or {}
		return _makeAPADSection(self._host, self._name, tostring(o.Title or o.Name or "Section"), self._pageId)
	end
	return tab
end

local function _loadAPADPage(pageId)
	local pageState = _APAD_PAGE_STATE[pageId]
	if pageState == "loading" or pageState == "loaded" then return end
	local sections = _APAD_PENDING[pageId]
	if not sections or #sections == 0 then return end
	_APAD_PAGE_STATE[pageId] = "loading"
	task.spawn(function()
		for _, sectionRecord in ipairs(sections) do
			if not ScorpioHubAlive() then return end
			local displayTab = sectionRecord.tabName == "ScorpioHub Terminal Online" and "Online" or sectionRecord.tabName
			local section, content = Components.CreateSection(
				sectionRecord.host,
				((sectionRecord.sectionName ~= "" and sectionRecord.sectionName ~= "Section") and sectionRecord.sectionName or displayTab),
				200
			)
			section.LayoutOrder = sectionRecord.order
			AddListLayout(content, Enum.FillDirection.Vertical, 6)
			_autoGrowSection(section, content)
			for _, record in ipairs(sectionRecord.controls) do
				_mountAPADControl(record, content)
				_paceAPADBuild()
			end
			task.wait()
		end
		_APAD_PAGE_STATE[pageId] = "loaded"
	end)
end
