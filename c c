local function playerSyntaxColor(line)
	line = line:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
	local out = line
	out = out:gsub("(%-%-[^\n]*)", "<font color='#385648'>%1</font>")
	out = out:gsub("(\"[^\"]*\")", "<font color='#FFA726'>%1</font>")
	local kw = { "local","function","end","if","then","else","elseif","return","for","in","do","while","repeat","until","and","or","not","nil","true","false","break" }
	for _, k in ipairs(kw) do
		out = out:gsub("(%f[%w_])(" .. k .. ")(%f[^%w_])", "%1<font color='#00F5D4'>%2</font>%3")
	end
	out = out:gsub("(%f[%w_])(%d+%.?%d*)(%f[^%w_])", "%1<font color='#FFA726'>%2</font>%3")
	return out
end

