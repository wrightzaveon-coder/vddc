local function startScorpioHubFly()
	flyEnabled = true
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local head = char:FindFirstChild("Head")
	if not hum or not head then return end
	getgenv().SwimMethod = true
	task.wait(0.3)
	hum.PlatformStand = true
	head.Anchored = true
	if flyCFLoop then flyCFLoop:Disconnect() end
	flyCFLoop = trackConn(RunService.RenderStepped:Connect(function(dt)
		if not ScorpioHubAlive() then return end
		if not flyEnabled then return end
		local currentHead = char:FindFirstChild("Head")
		if not currentHead then return end
		local speed = getgenv()._ccFlySpeed or 5
		local camera = workspace.CurrentCamera
		local cameraCF = camera.CFrame
		local cameraPosition = cameraCF.Position
		local objectVelocity = Vector3.zero
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
			local moveDirection = hum.MoveDirection
			if moveDirection.Magnitude > 0.1 then
				objectVelocity = (
					camera.CFrame.RightVector * moveDirection.X
					+ camera.CFrame.LookVector * -moveDirection.Z
				) * speed * dt * 60
			end
		else
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				objectVelocity = objectVelocity + Vector3.new(0, 0, -speed * dt * 60)
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				objectVelocity = objectVelocity + Vector3.new(0, 0, speed * dt * 60)
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				objectVelocity = objectVelocity + Vector3.new(-speed * dt * 60, 0, 0)
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				objectVelocity = objectVelocity + Vector3.new(speed * dt * 60, 0, 0)
			end
		end
		local headPosition = currentHead.Position
		local newCF = CFrame.new(headPosition) * (cameraCF - cameraPosition) * CFrame.new(objectVelocity)
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			newCF = newCF + Vector3.new(0, speed * dt * 10, 0)
