    local function waitForOwnedSpawn(model, timeout)
        local player = game:GetService("Players").LocalPlayer
        local deadline = os.clock() + (timeout or 10)
        repeat
            if not model or not model.Parent then return end
            local owner = model:FindFirstChild("Owner", true)
            if owner then
                local ownerValue = owner.Value
                if ownerValue == player or ownerValue == player.Name or tostring(ownerValue) == player.Name then
                    local seat = model:FindFirstChild("DriveSeat", true)
                        or model:FindFirstChildWhichIsA("VehicleSeat", true)
                    if seat then return seat, model end
