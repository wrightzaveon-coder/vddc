local function saveOriginals(t)
    if not modifiedTables[t] then
        modifiedTables[t] = {
            BulletSpeed = rawget(t, "BulletSpeed"),
            DropGravity = rawget(t, "DropGravity"),
            BulletParticleEnaled = rawget(t, "BulletParticleEnaled"),
