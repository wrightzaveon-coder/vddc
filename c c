local function _bindAPADTabScroll(scroll, layout)
	if not scroll then return end
	if scroll:GetAttribute("ScorpioHubCanvasBound") then return end
	layout = layout or scroll:FindFirstChildOfClass("UIListLayout")
	if not layout then return end
	scroll:SetAttribute("ScorpioHubCanvasBound", true)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.None
	scroll.Active = true
	scroll.ScrollingEnabled = true
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	local function refresh()
		if not scroll.Parent or not layout.Parent then return end
		local padding = scroll:FindFirstChildOfClass("UIPadding")
		local top = padding and padding.PaddingTop.Offset or 0
		local bottom = padding and padding.PaddingBottom.Offset or 0
		local extra = UserInputService.TouchEnabled and 110 or 40
		local height = layout.AbsoluteContentSize.Y / _getAPADInterfaceScale()
		scroll.CanvasSize = UDim2.new(0, 0, 0, math.ceil(height + top + bottom + extra))
	end
	table.insert(_APADLayoutRefreshers, refresh)
	trackConn(layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		task.defer(refresh)
	end))
	trackConn(scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		task.defer(refresh)
	end))
	task.defer(refresh)
	return refresh
end

